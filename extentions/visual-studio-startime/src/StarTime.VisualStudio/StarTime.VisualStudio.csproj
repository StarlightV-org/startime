<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <VsixOutputDirectory>$(MSBuildProjectDirectory)\..\..\build</VsixOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarTime.Core\StarTime.Core.csproj" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="registration.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Target Name="ReadStarTimeVersion" BeforeTargets="CoreCompile;CreateVsixContainer">
    <XmlPeek
      XmlInputPath="$(MSBuildProjectDirectory)\source.extension.vsixmanifest"
      Query="/*[local-name()='PackageManifest']/*[local-name()='Metadata']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="StarTimeVsixVersion" />
    </XmlPeek>
  </Target>

  <Target Name="GenerateStarTimeVersion" BeforeTargets="CoreCompile" DependsOnTargets="ReadStarTimeVersion">
    <PropertyGroup>
      <StarTimeVersionFile>$(IntermediateOutputPath)StarTimeVersion.g.cs</StarTimeVersionFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(StarTimeVersionFile)"
      Lines="namespace StarTime.VisualStudio { internal static class StarTimeVersion { public const string Value = &quot;$(StarTimeVsixVersion)&quot;%3B } }"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(StarTimeVersionFile)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyVersionedVsix" AfterTargets="CreateVsixContainer" DependsOnTargets="ReadStarTimeVersion">
    <PropertyGroup>
      <VersionedVsix>$(VsixOutputDirectory)\StarTime.VisualStudio.$(StarTimeVsixVersion).vsix</VersionedVsix>
    </PropertyGroup>
    <MakeDir Directories="$(VsixOutputDirectory)" />
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFiles="$(VersionedVsix)" />
    <Message Importance="high" Text="Versioned VSIX -> $(VersionedVsix)" />
  </Target>
</Project>
