{
	"name": "obsidian-startime",
	"version": "1.0.0",
	"main": "main.js",
	"description": "This is a plugin that integrates with StarTime to track your writing activity.",
	"keywords": [],
	"license": "MIT",
	"scripts": {
		"dev": "bun --bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"bump": "bun pm version patch --no-git-tag-version -f && bun version-bump.mjs && git add package.json manifest.json versions.json && git commit -m \"chore: Bump plugin version to $npm_package_version\"",
		"tag": "git tag -a $npm_package_version -m \"Release $npm_package_version\" && git push --tags",
		"lint": "eslint . --no-warn-ignored"
	},
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"dependencies": {
		"@codemirror/view": "^6.38.6",
		"fflate": "^0.8.3",
		"prettier": "^3.9.6",
		"zod": "^4.5.4"
	}
}
