{
	"name": "startime",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"check:unsafe": "turbo run check:unsafe",
		"check:write": "turbo run check:write",
		"dk": "drizzle-kit --config=./packages/db/drizzle.config.ts",
		"dev": "turbo run dev",
		"dev:web": "cd apps/nova-web && bun dev",
		"dev:socket": "cd apps/nova-socket && bun dev",
		"docker:build:app": "docker build -f Dockerfile.app -t nova-status-app:latest .",
		"docker:build:migrate": "docker build -f Dockerfile.migrate -t nova-status-migrate:latest .",
		"docker:build": "bun run docker:build:app && bun run docker:build:migrate"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.27",
		"@startime/db": "workspace:*",
		"@startime/env": "workspace:*",
		"@startime/print": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"@tanstack/react-query": "^5.101.4",
		"@trpc/client": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"better-auth": "^1.6.27",
		"drizzle-orm": "^0.45.2",
		"next": "^16.3.0",
		"postgres": "^3.4.9",
		"superjson": "^2.2.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.2",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.15",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"turbo": "^2.9.17",
		"typescript": "^7.0.2"
	}
}
