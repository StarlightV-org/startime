{
	"name": "startime",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"config:githooks": "git config core.hooksPath .githooks",
		"build": "turbo run build",
		"check": "turbo run check",
		"check:unsafe": "turbo run check:unsafe",
		"check:write": "turbo run check:write",
		"dk": "drizzle-kit --config=./packages/db/drizzle.config.ts",
		"cn": "bunx --bun shadcn add --yes -c apps/web",
		"web": "cd apps/web",
		"dev": "bun --cwd apps/web dev",
		"dev:im": "bun --cwd apps/importer dev",
		"i18n": "bun --cwd apps/web i18n:clean",
		"docker:build:app": "docker build -f Dockerfile.app -t nova-status-app:latest .",
		"docker:build:migrate": "docker build -f Dockerfile.migrate -t nova-status-migrate:latest .",
		"docker:build": "bun run docker:build:app && bun run docker:build:migrate",
		"license": "bun pm licenses --prod --json > licenses.json"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@better-auth/passkey": "^1.7.7",
		"@date-fns/tz": "^1.5.0",
		"@mantine/hooks": "^9.7.1",
		"@openpanel/nextjs": "^1.5.1",
		"@startime/db": "workspace:*",
		"@startime/env": "workspace:*",
		"@startime/print": "workspace:*",
		"@startime/service-auth": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"@tanstack/charts": "^1.0.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.1",
		"@trpc/client": "^11.19.0",
		"@trpc/react-query": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"@uploadthing/react": "^7.3.3",
		"better-auth": "^1.7.7",
		"chalk": "^6.0.1",
		"csv-parse": "^7.0.3",
		"d3-scale": "^4.0.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"fastify": "^5.12.5",
		"fflate": "^0.8.3",
		"ioredis": "^6.0.0",
		"ms": "^2.1.3",
		"next": "^16.3.8",
		"nuqs": "^2.9.6",
		"postgres": "^3.4.9",
		"react-dropzone": "^20.1.2",
		"short-unique-id": "^5.3.2",
		"superjson": "^2.2.6",
		"uploadthing": "^7.7.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/ms": "^2.1.0",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.11",
		"postcss": "^8.5.29",
		"prettier": "^3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"webmcp-types": "^0.1.10"
	}
}
