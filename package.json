{
	"name": "startime",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"config:githooks": "git config core.hooksPath .githooks",
		"build": "turbo run build",
		"check": "turbo run check",
		"check:unsafe": "turbo run check:unsafe",
		"check:write": "turbo run check:write",
		"dk": "drizzle-kit --config=./packages/db/drizzle.config.ts",
		"cn": "bunx --bun shadcn add --yes -c apps/web",
		"web": "cd apps/web",
		"dev": "bun --cwd apps/web dev",
		"dev:im": "bun --cwd apps/importer dev",
		"i18n": "bun --cwd apps/web i18n:clean",
		"docker:build:app": "docker build -f Dockerfile.app -t nova-status-app:latest .",
		"docker:build:migrate": "docker build -f Dockerfile.migrate -t nova-status-migrate:latest .",
		"docker:build": "bun run docker:build:app && bun run docker:build:migrate"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.29",
		"@better-auth/passkey": "^1.6.29",
		"@date-fns/tz": "^1.5.0",
		"@mantine/hooks": "^9.5.1",
		"@openpanel/nextjs": "^1.5.1",
		"@startime/db": "workspace:*",
		"@startime/env": "workspace:*",
		"@startime/print": "workspace:*",
		"@startime/service-auth": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"@tanstack/charts": "^0.14.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.101.4",
		"@trpc/client": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"@uploadthing/react": "^7.3.3",
		"better-auth": "^1.6.29",
		"chalk": "^6.0.0",
		"csv-parse": "^7.0.2",
		"d3-scale": "^4.0.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.12.0",
		"fflate": "^0.8.3",
		"ioredis": "^6.0.0",
		"next": "^16.3.1",
		"nuqs": "^2.9.6",
		"postgres": "^3.4.9",
		"react-dropzone": "^20.1.0",
		"short-unique-id": "^5.3.2",
		"superjson": "^2.2.6",
		"uploadthing": "^7.7.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"postcss": "^8.5.15",
		"prettier": "^3.8.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	}
}
